{
  "name": "exploding-kittens-web",
  "version": "2.0.0",
  "private": true,
  "description": "Web multiplayer Exploding Kittens (Party Pack rules, 2-10 players) — Next.js + Socket.IO",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "start:next": "next start -p ${PORT:-3000}",
    "ws": "tsx ws-server.ts",
    "ws:watch": "tsx watch --clear-screen=false ws-server.ts",
    "lint": "next lint"
  },
  "engines": { "node": ">=18.18" },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
